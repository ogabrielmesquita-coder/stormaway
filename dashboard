<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  />
  <title>Stormaway Route 13 – Wind & Ferry Status Dashboard</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary-blue: #0055a5;
      --secondary-blue: #1a73e8;
      --accent-gold: #ffc72c;
      --dark-blue: #003f7d;
      --bg-light: #f5f9ff;
      --card-radius: 16px;
      --shadow-strong: 0 18px 45px rgba(15, 23, 42, 0.3);
      --shadow-soft: 0 10px 30px rgba(15, 23, 42, 0.18);
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, sans-serif;
      background: radial-gradient(circle at top, #e3f0ff 0%, #f5f9ff 45%, #dbeafe 100%);
      color: #0f172a;
      min-height: 100vh;
      padding: 12px;          /* compact for Toughbook */
      font-size: 16px;        /* slightly larger base font */
    }

    .shell {
      max-width: 1440px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 22px;
      box-shadow: var(--shadow-strong);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(15, 23, 42, 0.08);
    }

    /* HEADER */
    .header {
      padding: 22px 26px 18px;
      background: linear-gradient(135deg, var(--primary-blue), var(--dark-blue));
      color: #ffffff;
      border-bottom: 3px solid var(--accent-gold);
    }

    .header-main {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      flex-wrap: wrap;
      align-items: center;
    }

    .header-title-block {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .title {
      font-size: clamp(1.6rem, 2.7vw, 2.2rem);
      font-weight: 750;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .subtitle {
      font-size: 0.92rem;
      opacity: 0.95;
    }

    .route {
      text-align: right;
      font-size: 0.82rem;
      opacity: 0.9;
    }

    .route span {
      display: block;
    }

    .header-badges {
      margin-top: 12px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 11px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.5);
      background: rgba(255, 255, 255, 0.2);
      font-size: 0.78rem;
    }

    .badge span {
      font-size: 1rem;
    }

    /* TABS */
    .tabs {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px 2px;
      border-bottom: 1px solid #e5e7eb;
      background: #eef2ff;
      flex-wrap: wrap;
    }

    .tab-buttons {
      display: inline-flex;
      border-radius: 999px;
      padding: 3px;
      background: #c7d2fe;
      box-shadow: 0 1px 4px rgba(15, 23, 42, 0.25) inset;
    }

    .tab-btn {
      border: none;
      background: transparent;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
      color: #111827;
      opacity: 0.7;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 0.18s ease, opacity 0.18s ease,
        transform 0.12s ease;
    }

    .tab-btn span {
      font-size: 1rem;
    }

    .tab-btn.active {
      background: #ffffff;
      opacity: 1;
      transform: translateY(-1px);
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);
    }

    .tabs-note {
      font-size: 0.78rem;
      color: #4b5563;
    }

    /* PANELS */
    .panels {
      background: var(--bg-light);
    }

    .panel {
      padding: 18px 20px 20px;
      display: block; /* default if JS fails */
    }

    .panel.hidden {
      display: none;
    }

    /* CREW VIEW (BIG NUMBERS) */
    .crew-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    @media (max-width: 900px) {
      .crew-grid {
        grid-template-columns: 1fr;
      }
    }

    .crew-card {
      background: #0b1120;
      color: #e5e7eb;
      border-radius: var(--card-radius);
      box-shadow: var(--shadow-soft);
      padding: 14px 16px 16px;
      border: 1px solid rgba(148, 163, 184, 0.4);
      display: flex;
      flex-direction: column;
      gap: 6px;
      position: relative;
      overflow: hidden;
    }

    .crew-label-row {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
    }

    .crew-name {
      font-size: 0.95rem;
      font-weight: 650;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .crew-tag {
      font-size: 0.75rem;
      background: rgba(15, 23, 42, 0.8);
      padding: 3px 8px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.6);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .crew-tag span {
      font-size: 0.95rem;
    }

    .crew-main-row {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-top: 4px;
    }

    .crew-wind {
      font-size: clamp(2.4rem, 4vw, 3.2rem); /* bigger for Toughbook */
      font-weight: 750;
      letter-spacing: 0.04em;
    }

    .crew-unit {
      font-size: 0.95rem;
      margin-bottom: 4px;
      opacity: 0.85;
    }

    .crew-extra {
      display: flex;
      flex-direction: column;
      gap: 2px;
      font-size: 0.8rem;
      opacity: 0.9;
    }

    .crew-extra strong {
      font-weight: 650;
      color: #f9fafb;
    }

    .crew-updated {
      margin-top: 4px;
      font-size: 0.73rem;
      color: #9ca3af;
    }

    .crew-actions {
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      font-size: 0.78rem;
    }

    .crew-open-link {
      text-decoration: none;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.9);
      color: #e5e7eb;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .crew-open-link span {
      font-size: 0.95rem;
    }

    .crew-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .status-dot {
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: #22c55e;
    }

    .status-dot.loading {
      background: #facc15;
    }

    .status-dot.error {
      background: #ef4444;
    }

    .crew-status-text {
      color: #9ca3af;
    }

    /* Ferry crew cards (no parsing, just links) */
    .crew-card.ferry-card {
      background: #020617;
      border-color: rgba(59, 130, 246, 0.6);
    }

    .ferry-body-text {
      margin-top: 6px;
      font-size: 0.8rem;
      color: #9ca3af;
    }

    .ferry-eta-hint {
      font-size: 0.78rem;
      color: #cbd5f5;
      margin-top: 4px;
    }

    /* TABLES VIEW (IFRAMES) */
    .tables-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    @media (max-width: 900px) {
      .tables-grid {
        grid-template-columns: 1fr;
      }
    }

    .table-card {
      background: #ffffff;
      border-radius: var(--card-radius);
      box-shadow: var(--shadow-soft);
      border: 1px solid #e5e7eb;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .table-header {
      padding: 10px 14px 8px;
      background: linear-gradient(
        to right,
        rgba(0, 85, 165, 0.98),
        rgba(26, 115, 232, 0.95)
      );
      color: #ffffff;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
    }

    .table-header-text {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .table-name {
      font-size: 1rem;
      font-weight: 650;
    }

    .table-sub {
      font-size: 0.78rem;
      opacity: 0.92;
    }

    .table-chip {
      font-size: 0.75rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.6);
      padding: 3px 8px;
      background: rgba(15, 23, 42, 0.3);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .table-chip span {
      font-size: 0.95rem;
    }

    .table-body {
      padding: 6px 8px 0;
      background: #f9fafb;
    }

    .table-help {
      font-size: 0.75rem;
      color: #4b5563;
      margin-bottom: 4px;
    }

    .frame-wrap {
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid #e5e7eb;
      background: #ffffff;
    }

    iframe {
      width: 100%;
      min-height: 280px;  /* shorter for Toughbook */
      border: none;
      display: block;
    }

    @media (max-width: 600px) {
      iframe {
        min-height: 240px;  /* shorter on small screens too */
      }
    }

    .table-footer {
      padding: 8px 10px 10px;
      background: #f3f4f6;
      border-top: 1px solid #e5e7eb;
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
      font-size: 0.75rem;
    }

    .table-note {
      color: #6b7280;
    }

    .table-link {
      text-decoration: none;
      padding: 6px 10px;
      border-radius: 999px;
      background: var(--accent-gold);
      color: #1f2937;
      font-size: 0.8rem;
      font-weight: 600;
      border: 1px solid #e5a400;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-left: auto;
    }

    .table-link span {
      font-size: 0.95rem;
    }

    /* FOOTER */
    .footer {
      padding: 10px 18px 14px;
      background: #020617;
      color: #9ca3af;
      font-size: 0.75rem;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .footer strong {
      color: #e5e7eb;
    }

    .footer a {
      color: #e5e7eb;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="shell">
    <!-- HEADER -->
    <header class="header">
      <div class="header-main">
        <div class="header-title-block">
          <div class="title">Stormaway – Wind & Ferry Status</div>
          <div class="subtitle">
            Live Environment Canada wind + BC Ferries current conditions for Route 13
          </div>
        </div>
        <div class="route">
          <span>BC Ferries Route 13</span>
          <span>Langdale ⇄ Keats Island ⇄ Gambier Island</span>
        </div>
      </div>

      <div class="header-badges">
        <div class="badge">
          <span>🌊</span> Howe Sound & Strait of Georgia wind
        </div>
        <div class="badge">
          <span>⛴️</span> HSB ⇄ Langdale mainline ferry status
        </div>
        <div class="badge">
          <span>📡</span> Live data from ECCC & BC Ferries
        </div>
      </div>
    </header>

    <!-- TABS -->
    <div class="tabs">
      <div class="tab-buttons">
        <button class="tab-btn active" id="crewTabBtn" type="button">
          <span>👀</span> Crew View (Big Numbers)
        </button>
        <button class="tab-btn" id="tablesTabBtn" type="button">
          <span>📋</span> Full Tables & Pages
        </button>
      </div>
      <div class="tabs-note">
        Crew View auto-parses wind from ECCC. Ferry ETAs open in BC Ferries pages.
        If anything fails, use the Full Tables tab.
      </div>
    </div>

    <div class="panels">
      <!-- CREW VIEW PANEL -->
      <section class="panel" id="crewPanel">
        <div class="crew-grid">
          <!-- Pam Rocks -->
          <article class="crew-card" id="card-pam">
            <div class="crew-label-row">
              <div class="crew-name">Pam Rocks</div>
              <div class="crew-tag">
                <span>🏔️</span> Howe Sound – main reference
              </div>
            </div>
            <div class="crew-main-row">
              <div>
                <div class="crew-wind" id="pam-wind">--</div>
                <div class="crew-unit">kt</div>
              </div>
              <div class="crew-extra">
                <div><strong>Dir:</strong> <span id="pam-dir">--</span></div>
                <div><strong>Gusts:</strong> <span id="pam-gust">--</span></div>
              </div>
            </div>
            <div class="crew-updated" id="pam-updated">
              Waiting for latest Environment Canada data…
            </div>
            <div class="crew-actions">
              <div class="crew-status">
                <div class="status-dot loading" id="pam-status-dot"></div>
                <span class="crew-status-text" id="pam-status-text">Loading…</span>
              </div>
              <a
                class="crew-open-link"
                href="https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=06400&stationID=WAS"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>🔗</span> Open ECCC page
              </a>
            </div>
          </article>

          <!-- Point Atkinson -->
          <article class="crew-card" id="card-point">
            <div class="crew-label-row">
              <div class="crew-name">Point Atkinson</div>
              <div class="crew-tag">
                <span>🗼</span> Entrance to Howe Sound
              </div>
            </div>
            <div class="crew-main-row">
              <div>
                <div class="crew-wind" id="point-wind">--</div>
                <div class="crew-unit">kt</div>
              </div>
              <div class="crew-extra">
                <div><strong>Dir:</strong> <span id="point-dir">--</span></div>
                <div><strong>Gusts:</strong> <span id="point-gust">--</span></div>
              </div>
            </div>
            <div class="crew-updated" id="point-updated">
              Waiting for latest Environment Canada data…
            </div>
            <div class="crew-actions">
              <div class="crew-status">
                <div class="status-dot loading" id="point-status-dot"></div>
                <span class="crew-status-text" id="point-status-text">Loading…</span>
              </div>
              <a
                class="crew-open-link"
                href="https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=04800&stationID=WSB"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>🔗</span> Open ECCC page
              </a>
            </div>
          </article>

          <!-- English Bay 46304 -->
          <article class="crew-card" id="card-english">
            <div class="crew-label-row">
              <div class="crew-name">English Bay – 46304</div>
              <div class="crew-tag">
                <span>🌊</span> Entrance buoy / sea-state
              </div>
            </div>
            <div class="crew-main-row">
              <div>
                <div class="crew-wind" id="english-wind">--</div>
                <div class="crew-unit">kt</div>
              </div>
              <div class="crew-extra">
                <div><strong>Dir:</strong> <span id="english-dir">--</span></div>
                <div><strong>Gusts:</strong> <span id="english-gust">--</span></div>
              </div>
            </div>
            <div class="crew-updated" id="english-updated">
              Waiting for latest Environment Canada data…
            </div>
            <div class="crew-actions">
              <div class="crew-status">
                <div class="status-dot loading" id="english-status-dot"></div>
                <span class="crew-status-text" id="english-status-text">Loading…</span>
              </div>
              <a
                class="crew-open-link"
                href="https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=14305&stationID=46304"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>🔗</span> Open ECCC page
              </a>
            </div>
          </article>

          <!-- Halibut Bank 46146 -->
          <article class="crew-card" id="card-halibut">
            <div class="crew-label-row">
              <div class="crew-name">Halibut Bank – 46146</div>
              <div class="crew-tag">
                <span>⚓</span> Outer Strait system check
              </div>
            </div>
            <div class="crew-main-row">
              <div>
                <div class="crew-wind" id="halibut-wind">--</div>
                <div class="crew-unit">kt</div>
              </div>
              <div class="crew-extra">
                <div><strong>Dir:</strong> <span id="halibut-dir">--</span></div>
                <div><strong>Gusts:</strong> <span id="halibut-gust">--</span></div>
              </div>
            </div>
            <div class="crew-updated" id="halibut-updated">
              Waiting for latest Environment Canada data…
            </div>
            <div class="crew-actions">
              <div class="crew-status">
                <div class="status-dot loading" id="halibut-status-dot"></div>
                <span class="crew-status-text" id="halibut-status-text">
                  Loading…
                </span>
              </div>
              <a
                class="crew-open-link"
                href="https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=14305&stationID=46146"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>🔗</span> Open ECCC page
              </a>
            </div>
          </article>

          <!-- Ferry HSB → Langdale -->
          <article class="crew-card ferry-card" id="card-ferry-hsb-lng">
            <div class="crew-label-row">
              <div class="crew-name">HSB → Langdale (Mainline Ferry)</div>
              <div class="crew-tag">
                <span>⛴️</span> Arrivals into Langdale
              </div>
            </div>
            <div class="ferry-body-text">
              Live BC Ferries current-conditions page for
              <strong>Horseshoe Bay → Langdale</strong>.
              Use this to estimate when passengers will arrive for Stormaway.
            </div>
            <div class="ferry-eta-hint">
              • Shows next scheduled departure, actual departure, ETA and any delays
              for the HSB → LNG sailings.
            </div>
            <div class="crew-actions" style="margin-top: 10px;">
              <div class="crew-status">
                <div class="status-dot"></div>
                <span class="crew-status-text">
                  Open BC Ferries page for full timing details.
                </span>
              </div>
              <a
                class="crew-open-link"
                href="https://www.bcferries.com/current-conditions/HSB-LNG"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>🔗</span> Open HSB → Langdale status
              </a>
            </div>
          </article>

          <!-- Ferry Langdale → HSB -->
          <article class="crew-card ferry-card" id="card-ferry-lng-hsb">
            <div class="crew-label-row">
              <div class="crew-name">Langdale → HSB (Mainline Ferry)</div>
              <div class="crew-tag">
                <span>⛴️</span> Departures from Langdale
              </div>
            </div>
            <div class="ferry-body-text">
              Live BC Ferries current-conditions page for
              <strong>Langdale → Horseshoe Bay</strong>.
              Useful for seeing outbound connections and overall schedule pressure.
            </div>
            <div class="ferry-eta-hint">
              • Check actual departure times, ETAs and delays that might affect
              passenger flow through Langdale.
            </div>
            <div class="crew-actions" style="margin-top: 10px;">
              <div class="crew-status">
                <div class="status-dot"></div>
                <span class="crew-status-text">
                  Open BC Ferries page for live sailing details.
                </span>
              </div>
              <a
                class="crew-open-link"
                href="https://www.bcferries.com/current-conditions/LNG-HSB"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>🔗</span> Open Langdale → HSB status
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- TABLES / PAGES VIEW PANEL -->
      <section class="panel hidden" id="tablesPanel">
        <div class="tables-grid">
          <!-- Pam Rocks iframe -->
          <section class="table-card">
            <div class="table-header">
              <div class="table-header-text">
                <div class="table-name">Pam Rocks</div>
                <div class="table-sub">Howe Sound – Current Conditions</div>
              </div>
              <div class="table-chip">
                <span>🏔️</span> Howe Sound – Pam Rocks
              </div>
            </div>
            <div class="table-body">
              <div class="table-help">
                Full ECCC current-conditions table for Howe Sound – Pam Rocks.
              </div>
              <div class="frame-wrap">
                <iframe
                  src="https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=06400&stationID=WAS"
                  title="Howe Sound - Pam Rocks current conditions"
                ></iframe>
              </div>
            </div>
            <div class="table-footer">
              <div class="table-note">
                If the table does not show inside the box, use the button to open it
                in a new tab/window.
              </div>
              <a
                class="table-link"
                href="https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=06400&stationID=WAS"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>🔗</span> Open Pam Rocks
              </a>
            </div>
          </section>

          <!-- Point Atkinson iframe -->
          <section class="table-card">
            <div class="table-header">
              <div class="table-header-text">
                <div class="table-name">Point Atkinson</div>
                <div class="table-sub">Pacific – South Coast – Current Conditions</div>
              </div>
              <div class="table-chip">
                <span>🗼</span> Point Atkinson
              </div>
            </div>
            <div class="table-body">
              <div class="table-help">
                ECCC lightstation observations – wind at the entrance to Howe Sound.
              </div>
              <div class="frame-wrap">
                <iframe
                  src="https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=04800&stationID=WSB"
