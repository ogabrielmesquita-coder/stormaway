  <script>
    // ---- Tab switching ----
    (function () {
      const crewBtn = document.getElementById("crewTabBtn");
      const tablesBtn = document.getElementById("tablesTabBtn");
      const crewPanel = document.getElementById("crewPanel");
      const tablesPanel = document.getElementById("tablesPanel");

      function showCrew() {
        crewBtn.classList.add("active");
        tablesBtn.classList.remove("active");
        crewPanel.classList.remove("hidden");
        tablesPanel.classList.add("hidden");
      }

      function showTables() {
        tablesBtn.classList.add("active");
        crewBtn.classList.remove("active");
        tablesPanel.classList.remove("hidden");
        crewPanel.classList.add("hidden");
      }

      crewBtn.addEventListener("click", showCrew);
      tablesBtn.addEventListener("click", showTables);
    })();

    // ---- Live data fetching for Crew View (ECCC only) ----
    (function () {
      const STATIONS = [
        {
          key: "pam",
          name: "Pam Rocks",
          url:
            "https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=06400&stationID=WAS",
        },
        {
          key: "point",
          name: "Point Atkinson",
          url:
            "https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=04800&stationID=WSB",
        },
        {
          key: "english",
          name: "English Bay – 46304",
          url:
            "https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=14305&stationID=46304",
        },
        {
          key: "halibut",
          name: "Halibut Bank – 46146",
          url:
            "https://weather.gc.ca/marine/weatherConditions-currentConditions_e.html?mapID=02&siteID=14305&stationID=46146",
        },
      ];

      function setStatus(key, status, message) {
        const dot = document.getElementById(key + "-status-dot");
        const text = document.getElementById(key + "-status-text");

        if (!dot || !text) return;

        dot.classList.remove("loading", "error");
        if (status === "ok") {
          dot.className = "status-dot";
          text.textContent = message || "Live ECCC data";
        } else if (status === "loading") {
          dot.className = "status-dot loading";
          text.textContent = message || "Loading…";
        } else if (status === "error") {
          dot.className = "status-dot error";
          text.textContent =
            message || "Data not available – use ECCC link / Full Tables tab";
        }
      }

      function updateValues(key, dir, speed, gusts, timeString) {
        const windEl = document.getElementById(key + "-wind");
        const dirEl = document.getElementById(key + "-dir");
        const gustEl = document.getElementById(key + "-gust");
        const updEl = document.getElementById(key + "-updated");

        if (windEl) windEl.textContent = speed || "--";
        if (dirEl) dirEl.textContent = dir || "--";
        if (gustEl) gustEl.textContent = gusts || "--";
        if (updEl && timeString) {
          updEl.textContent = "Obs time: " + timeString;
        }
      }

      // Parse wind line from inner text of the ECCC HTML
      function parseWind(text) {
        const windBlockMatch = text.match(
          /Wind\s*\([^)]*\)\s*(.+?)(?:Air temperature|Wave height|Pressure and tendency|Visibility)/s
        );
        let windChunk = windBlockMatch ? windBlockMatch[1] : null;
        if (windChunk) {
          windChunk = windChunk.replace(/\s+/g, " ").trim();
        }

        let dir = null;
        let speed = null;
        let gusts = null;

        if (windChunk) {
          const m = windChunk.match(
            /^([A-Z]{1,3})\s+(\d+)(?:\s+gusts\s+(\d+))?/i
          );
          if (m) {
            dir = m[1].toUpperCase();
            speed = m[2];
            gusts = m[3] || "—";
          } else {
            dir = windChunk;
            speed = "--";
            gusts = "—";
          }
        }

        const timeMatch = text.match(
          /(\d{1,2}:\d{2}\s*(?:AM|PM)\s+[A-Z]{2,4}\s+\d{1,2}\s+\w+\s+\d{4})/
        );
        const timeString = timeMatch ? timeMatch[1] : null;

        return { dir, speed, gusts, timeString };
      }

      async function fetchStation(station) {
        setStatus(station.key, "loading");

        try {
          const response = await fetch(station.url, { method: "GET" });
          if (!response.ok) {
            throw new Error("HTTP " + response.status);
          }
          const html = await response.text();
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, "text/html");
          const text = doc.body
            ? (doc.body.innerText || doc.body.textContent || "")
            : html;

          const { dir, speed, gusts, timeString } = parseWind(text);

          if (!dir && !speed) {
            throw new Error("Wind line not found");
          }

          updateValues(station.key, dir, speed, gusts, timeString);
          setStatus(station.key, "ok");
        } catch (err) {
          console.error("Error loading station", station.name, err);
          setStatus(
            station.key,
            "error",
            "Cannot read data (likely browser security). Use ECCC page / Full Tables tab."
          );
          updateValues(station.key, null, "--", "—", null);
        }
      }

      async function refreshAll() {
        for (const s of STATIONS) {
          fetchStation(s);
        }
      }

      // First run + periodic refresh
      refreshAll();
      setInterval(refreshAll, 30 * 60 * 1000); // every 30 minutes
    })();
  </script>
